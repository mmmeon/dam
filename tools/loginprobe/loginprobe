#!/bin/zsh
#
#  loginprobe
#
#  Finds out what DAM could do at the login window, before anyone has signed in: whether a
#  process there can capture the screen (CGDisplayCreateImage, CGDisplayStream,
#  ScreenCaptureKit), make a CGVirtualDisplay, and move the pointer. loginprobe.swift does the
#  trying; this builds it and runs it here, or installs it as a LaunchAgent limited to the
#  LoginWindow session, which launchd starts as root when the login window comes up.
#
#    tools/loginprobe/loginprobe run          in this session, for comparison (no root)
#    tools/loginprobe/loginprobe install      the LaunchAgent (asks for the admin password)
#    tools/loginprobe/loginprobe install stream   instead streams the login window as MJPEG on
#                                                 port 8090 until sign-in
#    tools/loginprobe/loginprobe install devices  instead lists Sidecar's iPads and AirPlay
#                                                 receivers there
#    tools/loginprobe/loginprobe install checks   instead tries hardware H.264, an iPad's receiver
#                                                 through usbmuxd, and a virtual display alone
#    tools/loginprobe/loginprobe results      every report so far, newest last
#    tools/loginprobe/loginprobe uninstall    the LaunchAgent and its binary; keeps results
#
#  After install, log out (Apple menu → Log Out) and wait about 30 s at the login window: the
#  probe waits 15 s for the window server to settle, then takes ~20 s. A display flickers as
#  the virtual one comes and goes, and the pointer jumps 40 px and back. Log in, then
#  `results`. Each run leaves report.txt and PNGs in /Library/Logs/DAMLoginProbe/<time>
#  (or /tmp/dam-loginprobe/<time> for `run`). `run --stream 8090` tries the stream here.
#
#  sudo can't ask for a password without a terminal (Claude Code's `!` prompt); the root steps
#  then ask through macOS's administrator dialog instead.
#

set -u
setopt pipefail

here=${0:A:h}
repo=${here:h:h}
label=mmmeon.dam.loginprobe
cache=${TMPDIR:-/tmp}/dam-loginprobe
binary=$cache/loginprobe
installed="/Library/Application Support/DAM/loginprobe"
plist=/Library/LaunchAgents/$label.plist
logs=/Library/Logs/DAMLoginProbe

die() { print -u2 "loginprobe: $*"; exit 1 }
say() { print "loginprobe: $*" }

# Runs a /bin/sh script as root.
as_root() {
    if [[ -t 0 ]] || sudo -n true 2>/dev/null; then
        sudo /bin/sh -c "$1"
    else
        print -r -- "$1" > $cache/as-root.sh
        osascript -e "do shell script \"/bin/sh '$cache/as-root.sh'\" with administrator privileges" >/dev/null
    fi
}

build() {
    mkdir -p $cache
    # What's built here is installed as root: not from a folder someone else made.
    [[ -O $cache ]] || die "$cache is not yours"
    local source=$here/loginprobe.swift
    if [[ ! -x $binary || $source -nt $binary ]]; then
        DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} \
            swiftc -O -suppress-warnings -import-objc-header $repo/DAM/CGVirtualDisplayPrivate.h \
            -o $binary $source || die "could not build loginprobe.swift"
        # Signed, TCC's Screen Recording and Accessibility grants follow the identifier and
        # team; unsigned, they follow the exact binary and are lost on every rebuild.
        local identity=$(security find-identity -v -p codesigning | awk -F'"' '/Apple Development/ { print $2; exit }')
        if [[ -n $identity ]]; then
            codesign --force --sign "$identity" --identifier $label $binary || die "could not sign loginprobe"
        fi
    fi
}

cmd_run() {
    build
    $binary /tmp/dam-loginprobe/$(date +%Y%m%d-%H%M%S)-${USER} "$@"
}

cmd_install() {
    build
    local staged=$cache/$label.plist mode=loginwindow extra=
    case ${1:-} in
        "") ;;
        stream) mode=stream extra=" --stream 8090" ;;
        devices) mode=devices extra=" --devices" ;;
        checks) mode=checks extra=" --checks" ;;
        *) die "install takes nothing, stream, devices or checks" ;;
    esac
    # A wrapper names each run's folder by the time it starts.
    cat > $cache/start <<EOF
#!/bin/sh
exec "$installed/loginprobe" "$logs/\$(date +%Y%m%d-%H%M%S)-$mode" --delay 15$extra
EOF
    cat > $staged <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$label</string>
    <key>LimitLoadToSessionType</key>
    <string>LoginWindow</string>
    <key>ProgramArguments</key>
    <array>
        <string>$installed/start</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>$logs/launchd.log</string>
</dict>
</plist>
EOF
    plutil -lint -s $staged || die "the plist does not parse"
    say "installing $plist and \"$installed\" ($mode; as root)"
    as_root "
        set -e
        mkdir -p '$installed' '$logs'
        install -o root -g wheel -m 755 '$binary' '$installed/loginprobe'
        install -o root -g wheel -m 755 '$cache/start' '$installed/start'
        install -o root -g wheel -m 644 '$staged' '$plist'
        chmod 755 '$logs'
    " || die "install failed"
    [[ $mode == stream ]] && say "at the login window, open http://<this Mac>:8090/ from another device; its address is in the report"
    say "installed. Log out, wait ~30 s at the login window, log in, then: $0 results (it runs at every login window until $0 uninstall)"
}

cmd_results() {
    local report
    for report in /tmp/dam-loginprobe/*/report.txt(N) $logs/*/report.txt(N); do
        print "== ${report:h}"
        cat $report
        print
    done
    [[ -f $logs/launchd.log ]] && { print "== $logs/launchd.log"; tail -20 $logs/launchd.log }
    true
}

cmd_uninstall() {
    say "removing $plist and \"$installed\" (as root); results stay in $logs"
    as_root "rm -f '$plist'; rm -rf '$installed'; rmdir '${installed:h}' 2>/dev/null; true"
}

case ${1:-} in
    run) shift; cmd_run "$@" ;;
    install) cmd_install ${2:-} ;;
    results) cmd_results ;;
    uninstall) cmd_uninstall ;;
    *) sed -n '3,29p' $0 | sed -E 's/^# ?//'; exit 2 ;;
esac
